# === SIH26047 MediKiosk — Environment Configuration Template ===
# Copy this to .env and fill in real values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medikiosk:medikiosk@localhost:5433/medikiosk

# ── Groq LLM API ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_API_BASE=https://api.groq.com/openai/v1
GROK_MODEL=llama-3.3-70b-versatile

# ── JWT Secret ────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_DIR=/home/user/MEDIKIOSK/storage/documents

# ── Embeddings (Hugging Face Cloud API — no GPU needed) ───────────────────────
HF_TOKEN=hf_CHANGE_ME
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
USE_HF_EMBEDDINGS_API=true

# ── LangSmith Tracing (optional) ─────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=CHANGE_ME
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_PROJECT=MEDIKIOSK