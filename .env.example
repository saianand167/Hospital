# MediKiosk Part 1 - Configuration

# Grok API (xAI) or Groq API (High-speed Llama-3.3)
GROK_API_KEY=your_grok_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Development & Offline Mock Mode (true / false)
MOCK_MODE=false

# Default language (en, te, hi)
DEFAULT_LANGUAGE=en

# Voice ASR Settings (faster-whisper local model: tiny, base, small, medium, large-v3)
ASR_MODEL_SIZE=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
