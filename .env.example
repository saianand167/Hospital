# ══════════════════════════════════════════════════════════════════
#  SIH26047 — MediKiosk  |  Environment Template
#  Copy this file to .env and fill in real values
#  NEVER commit .env — only commit this .env.example file
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL (Docker) ──────────────────────────────────────────
POSTGRES_USER=medikiosk_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=medikiosk_db
POSTGRES_PORT=5433

DATABASE_URL=postgresql://medikiosk_user:your_secure_password_here@localhost:5433/medikiosk_db

# ── Groq LLM API ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Application ───────────────────────────────────────────────────
MOCK_MODE=false
DEFAULT_LANGUAGE=en

# ── JWT Auth ──────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string

# ── File Storage ──────────────────────────────────────────────────
STORAGE_DIR=./uploads

# ── Frontend → Backend ────────────────────────────────────────────
BACKEND_API_BASE=http://localhost:8000/api/v1
PART3_BACKEND_URL=http://localhost:8000/api/v1

# ── Embeddings ────────────────────────────────────────────────────
USE_HF_EMBEDDINGS_API=false
HF_TOKEN=your_hf_token_if_needed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── ASR / Voice ───────────────────────────────────────────────────
ASR_MODEL_SIZE=medium
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8

# ── OCR ───────────────────────────────────────────────────────────
OCR_PROVIDER=mock
LLM_PROVIDER=groq
OCR_CONFIDENCE_THRESHOLD=0.75
